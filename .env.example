# ── Neon Postgres ────────────────────────────────────────────────
# Neon Console → Dashboard → Connect. Pooled string for the app,
# direct (unpooled) string for drizzle-kit migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Neon Auth (managed Better Auth) ──────────────────────────────
# Neon Console → Auth → Configuration → "Auth URL"
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth"
# openssl rand -base64 32   (min 32 chars)
NEON_AUTH_COOKIE_SECRET=""

# ── PowerSync ────────────────────────────────────────────────────
# PowerSync Dashboard → your instance → Connect → instance URL
POWERSYNC_URL="https://xxxxxxxx.powersync.journeyapps.com"
# HS256 key shared with PowerSync Client Auth (base64url, no padding):
#   openssl rand 32 | basenc --base64url | tr -d '='
POWERSYNC_JWT_SECRET=""
# Must match the key id ("kid") you enter in PowerSync Client Auth
POWERSYNC_JWT_KID="tickets"

# ── Site ─────────────────────────────────────────────────────────
# Public origin used for canonical URLs, Open Graph and the sitemap
# (falls back to VERCEL_PROJECT_PRODUCTION_URL, then localhost)
NEXT_PUBLIC_SITE_URL="https://tickets.example.com"
